# Kabin tanıtım sitesi — Hostinger (LiteSpeed / Apache uyumlu)
# Bu depo olduğu gibi public_html'e açılır; yalnız site dosyaları dışarıdan erişilebilir olmalı.

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset utf-8
ServerSignature Off
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

AddType font/woff2 .woff2
AddType image/svg+xml .svg
AddType image/webp .webp
AddType model/gltf+json .gltf
AddType application/octet-stream .bin
AddType text/plain .txt
AddType text/markdown .md
AddType application/xml .xml
AddCharset utf-8 .md .txt .xml

<IfModule mod_rewrite.c>
  RewriteEngine On

  # PHP çalışmadan dosya yüklemelerini reddet. Form yalnız URL-encoded metindir.
  RewriteCond %{REQUEST_URI} ^/api/basvuru\.php$
  RewriteCond %{REQUEST_METHOD} =POST
  RewriteCond %{HTTP:Content-Type} !^application/x-www-form-urlencoded(;.*)?$ [NC]
  RewriteRule ^ - [R=415,L]

  # 1) Her zaman HTTPS (Hostinger CDN arkasında X-Forwarded-Proto da kontrol edilir).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 1b) Tek kanonik adres: www → kök alan adı (sayfalardaki rel=canonical zaten kök adresi gösterir;
  #     aynı içeriğin iki adreste yaşaması HSTS/çerez/önbellek sınırını ikiye böler). Form ucu dahil.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2) Gizli dosya ve klasörler (.git, .gitignore, .htaccess …) — .well-known hariç (SSL doğrulaması ve security.txt).
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [R=404,L]

  # 3) Kaynak, test ve belge dosyaları yayımlanmaz. Sayfaların .md sürümleri (build.py üretir) açıktır;
  #    depo belgeleri (README, YAYIN-KONTROL) kapalıdır.
  RewriteRule ^(_kaynak|_test|node_modules|api/_lib)(/|$) - [R=404,L]
  RewriteRule \.(py|ts|json|lock|sh|mjs|cjs|map|example\.php|tsbuildinfo|bak|log|jsonl)$ - [R=404,L]
  RewriteRule (^|/)(README|YAYIN-KONTROL|LICENSE|package\.json|package-lock\.json)[^/]*$ - [R=404,L]

  # 4) api/ altında yalnız başvuru ucu çalışır.
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteCond %{REQUEST_URI} !^/api/basvuru\.php$
  RewriteRule ^ - [R=404,L]

  # 5) Yapay zekâ ajanları için içerik anlaşması: "Accept: text/markdown" isteyen istemciye sayfanın
  #    Markdown sürümü verilir (aynı adreste). Tarayıcılar bu türü istemez; onlara HTML gider.
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1index.md -f
  RewriteRule ^(.*/)?$ $1index.md [L]
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1.md -f
  RewriteRule ^(.+)\.html$ $1.md [L]
</IfModule>

<Files "basvuru.php">
  LimitRequestBody 16384
  # api/.user.ini'nin yedeği: Hostinger (LiteSpeed) .user.ini'yi bu ayar için uygulamadı (2026-11-09:
  # canlı uç fail-closed 500). PHP_INI_PERDIR ayarı LiteSpeed'de .htaccess ile verilir; başka sunucu yok sayar.
  <IfModule LiteSpeed>
    php_flag enable_post_data_reading off
  </IfModule>
</Files>

# mod_rewrite yoksa ikinci savunma hattı.
<FilesMatch "(^\.|\.(py|ts|json|lock|sh|mjs|map|jsonl|log)$|\.example\.php$|^(README|YAYIN-KONTROL)[^/]*$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # includeSubDomains: api./app. (VPS, Caddy) ve www. zaten yalnız HTTPS (2026-11-10 doğrulandı: http → 308).
  # "preload" bilerek yok: tarayıcı listesine girince geri alınamaz; alan adı kesinleşince eklenir.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # HTML ve Markdown her zaman yeniden doğrulanır; aynı adres Accept'e göre iki türde dönebilir.
  <FilesMatch "\.(html|md)$">
    Header set Cache-Control "no-cache"
    Header merge Vary "Accept"
  </FilesMatch>
  # Ajanların siteyi keşfetmesi için (RFC 8288). Göreli adres isteğin adresine göre çözülür:
  # "/" → /index.md, "/yasal/" → /yasal/index.md. Tek tırnak: LiteSpeed \" kaçışını çözmez, değere yazar.
  <FilesMatch "^index\.html$">
    Header append Link '<index.md>; rel="alternate"; type="text/markdown"'
  </FilesMatch>
  <FilesMatch "\.html$">
    Header append Link '</llms.txt>; rel="describedby"; type="text/plain"'
    Header append Link '</sitemap.xml>; rel="sitemap"; type="application/xml"'
  </FilesMatch>
  # Markdown sürümleri HTML sayfalarının kopyasıdır: ajanlar okur, arama motoru dizinine girmez.
  <FilesMatch "\.md$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Yazı tipi, görsel ve 3B model: adları içerikle birlikte değişir (aynı adla yeni içerik konmaz).
  <FilesMatch "\.(woff2|svg|webp|jpg|gltf|bin)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
